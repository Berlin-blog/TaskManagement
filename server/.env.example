# MySQL 连接配置
# 数据库需已存在：CREATE DATABASE task_schedule DEFAULT CHARSET utf8mb4;
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# 填入你自己的 MySQL 密码；server/.env 已被 .gitignore 忽略，不要提交真实密码
DB_PASSWORD=
DB_NAME=task_schedule

# 后端服务端口
PORT=3001

# 附件存储目录（留空 = 默认 %LOCALAPPDATA%\TaskSchedule\uploads）
# UPLOAD_DIR=D:\TaskData\uploads

# 附件总配额（MB），超过后拒绝上传
UPLOAD_QUOTA_MB=2048

# 删除任务后附件保留时长（小时），用于「撤销删除」把留档文件一起恢复
ATTACHMENT_GRACE_HOURS=24
